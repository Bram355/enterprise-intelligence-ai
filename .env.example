# Copy to .env.local and fill in. Only browser-safe values belong here.
# Local development: run `npm run db:start` and copy PUBLISHABLE_KEY from its output.
# `/supabase` goes through the Vite dev-server proxy to the local stack (http://127.0.0.1:54321).
# For a hosted project use its full URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=
